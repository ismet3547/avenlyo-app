API_PORT=4001
API_HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:3001
SUPABASE_URL=http://127.0.0.1:55321
# Add your own local keys; omit unused optional variables rather than leaving empty values.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PUBLIC_APP_URL=http://localhost:3001
# Instagram Login API v26.0; only the API/operator environment has these secrets.
INSTAGRAM_API_VERSION=v26.0
# INSTAGRAM_META_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_WEBHOOK_URL=https://your-api.example/v1/webhooks/instagram
# Disabled still records staff notification failures honestly; CI uses a fake provider.
BUSINESS_NOTIFICATION_PROVIDER=disabled
# RESEND_API_KEY=
# BUSINESS_NOTIFICATION_FROM=Avenlyo <notifications@your-verified-domain.example>
